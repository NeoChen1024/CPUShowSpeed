{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeoChen1024/CPUShowSpeed/data/curated/schema.json",
  "title": "CPUShowSpeed curated tables",
  "description": "Row schemas and table contracts for data/curated. Semantics are owned by docs/data-schema.md.",
  "x-schema-version": "1.2.0",
  "x-tables": {
    "source": {
      "file": "source.jsonl",
      "row": "#/$defs/source",
      "primary_key": "source_id",
      "description": "One identified document, page revision or dataset snapshot."
    },
    "processor_family": {
      "file": "processor_family.jsonl",
      "row": "#/$defs/processor_family",
      "primary_key": "family_id",
      "foreign_keys": {
        "source_ids": "source"
      },
      "description": "Most specific processor line a source text can identify (e.g. Intel Xeon, IBM POWER7)."
    },
    "processor_sku": {
      "file": "processor_sku.jsonl",
      "row": "#/$defs/processor_sku",
      "primary_key": "sku_id",
      "foreign_keys": {
        "family_id": "processor_family",
        "source_ids": "source"
      },
      "description": "One sold processor model; generation labels stay verbatim from sources."
    },
    "alias": {
      "file": "alias.jsonl",
      "row": "#/$defs/alias",
      "primary_key": "alias_id",
      "foreign_keys": {
        "entity_id": "@entity_kind",
        "source_id": "source"
      },
      "description": "Judgements linking source text to entities: exact text, regex pattern or a versioned rule."
    },
    "vendor": {
      "file": "vendor.jsonl",
      "row": "#/$defs/vendor",
      "primary_key": "vendor_id",
      "description": "Organisations named as hardware vendors; only spellings of one legal entity are merged."
    },
    "system_model": {
      "file": "system_model.jsonl",
      "row": "#/$defs/system_model",
      "primary_key": "system_id",
      "foreign_keys": {
        "vendor_ids": "vendor",
        "source_ids": "source"
      },
      "description": "Hand-curated system models; SPEC models are derived by rule spec-system-v1 at build time."
    }
  },
  "$defs": {
    "iso_day": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "partial_date": {
      "description": "ISO text at its stated precision; quarters are YYYY-Qn.",
      "type": "string",
      "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
    },
    "date_precision": {
      "enum": [
        "year",
        "quarter",
        "month",
        "day"
      ]
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src:[a-z0-9][a-z0-9._/@+-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "origin"
      ],
      "properties": {
        "status": {
          "enum": [
            "citation_only",
            "search_excerpt_only",
            "inventory_only",
            "index_reviewed",
            "text_reviewed",
            "method_text_checked",
            "thread_text_checked",
            "relevant_section_checked",
            "metadata_indexed_section_and_run_instructions_checked",
            "selected_table_pages_rendered_and_layout_spot_checked",
            "selected_pages_verified",
            "date_scope_review_complete",
            "machine_parsed_unreviewed"
          ]
        },
        "scope": {
          "description": "What the review covered, e.g. a page range, claim type or locator.",
          "$ref": "#/$defs/text"
        },
        "reviewed_on": {
          "$ref": "#/$defs/iso_day"
        },
        "origin": {
          "description": "Legacy registry the review was migrated from.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "provenance_class",
        "acquisition_status",
        "reviews",
        "legacy_ids"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "kind": {
          "enum": [
            "pdf",
            "postscript",
            "web_page",
            "wiki_revision",
            "spec_result",
            "text_file",
            "program_source",
            "archive_file",
            "usenet_post",
            "book",
            "dataset"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/text"
        },
        "final_url": {
          "$ref": "#/$defs/text"
        },
        "alternate_urls": {
          "description": "Other spellings of the same source's address found in legacy registries.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "store": {
          "description": "Root that local_path is relative to.",
          "enum": [
            "bitsavers_mirror",
            "repo"
          ]
        },
        "local_path": {
          "$ref": "#/$defs/text"
        },
        "hash_algo": {
          "enum": [
            "blake3",
            "sha256"
          ]
        },
        "hash": {
          "$ref": "#/$defs/hex64"
        },
        "revision": {
          "$ref": "#/$defs/text"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retrieved_on": {
          "$ref": "#/$defs/iso_day"
        },
        "date": {
          "description": "Publication date of the source itself.",
          "$ref": "#/$defs/partial_date"
        },
        "date_precision": {
          "$ref": "#/$defs/date_precision"
        },
        "provenance_class": {
          "enum": [
            "primary_original",
            "vendor",
            "contemporary_secondary",
            "modern_secondary",
            "historical_museum",
            "benchmark_org",
            "unclassified"
          ]
        },
        "provider": {
          "$ref": "#/$defs/text"
        },
        "work_id": {
          "description": "Groups sources from one work or compilation so they are not counted as independent.",
          "$ref": "#/$defs/text"
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "acquisition_status": {
          "enum": [
            "not_acquired",
            "acquired",
            "failed"
          ]
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "legacy_ids": {
          "description": "Identities this row was migrated from, as <registry>:<key>.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "dependentRequired": {
        "date": [
          "date_precision"
        ],
        "date_precision": [
          "date"
        ],
        "hash": [
          "hash_algo"
        ],
        "hash_algo": [
          "hash"
        ],
        "local_path": [
          "store"
        ],
        "store": [
          "local_path"
        ]
      }
    },
    "family_id": {
      "type": "string",
      "pattern": "^fam:[a-z0-9][a-z0-9.+-]*$"
    },
    "sku_id": {
      "type": "string",
      "pattern": "^sku:[a-z0-9][a-z0-9.+-]*$"
    },
    "alias_id": {
      "type": "string",
      "pattern": "^alias:[a-z0-9][a-z0-9./+-]*$"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_id"
      },
      "uniqueItems": true
    },
    "processor_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "vendor",
        "name"
      ],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/family_id"
        },
        "vendor": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        }
      }
    },
    "processor_sku": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku_id",
        "family_id",
        "vendor",
        "model",
        "keys",
        "source_ids"
      ],
      "properties": {
        "sku_id": {
          "$ref": "#/$defs/sku_id"
        },
        "family_id": {
          "$ref": "#/$defs/family_id"
        },
        "vendor": {
          "$ref": "#/$defs/text"
        },
        "model": {
          "description": "Model name as printed in the source table.",
          "$ref": "#/$defs/text"
        },
        "keys": {
          "description": "Match keys produced by versioned rules, as <rule>:<key>.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "base_clocks_mhz": {
          "description": "Every base frequency listed for this model; several when revisions differ.",
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uniqueItems": true
        },
        "sections": {
          "description": "Verbatim source heading paths (generation, codename).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids",
          "minItems": 1
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias_id",
        "entity_kind",
        "match_kind",
        "scope",
        "status"
      ],
      "properties": {
        "alias_id": {
          "$ref": "#/$defs/alias_id"
        },
        "entity_kind": {
          "enum": [
            "processor_sku",
            "processor_family",
            "vendor",
            "system_model"
          ]
        },
        "entity_id": {
          "description": "Target entity; omitted for rules, whose output names the entity.",
          "$ref": "#/$defs/text"
        },
        "match_kind": {
          "enum": [
            "exact_text",
            "pattern",
            "rule"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "pattern": {
          "$ref": "#/$defs/text"
        },
        "rule_id": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "description": "Field and source scope: processor, vendor or system, optionally @<glob> over mention scopes such as spec:*.",
          "$ref": "#/$defs/text"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clock_within": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "status": {
          "enum": [
            "accepted",
            "candidate",
            "rejected"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "reviewed_on": {
          "$ref": "#/$defs/iso_day"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "match_kind": {
                "const": "exact_text"
              }
            }
          },
          "then": {
            "required": [
              "text",
              "entity_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "match_kind": {
                "const": "pattern"
              }
            }
          },
          "then": {
            "required": [
              "pattern",
              "entity_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "match_kind": {
                "const": "rule"
              }
            }
          },
          "then": {
            "required": [
              "rule_id"
            ],
            "not": {
              "required": [
                "entity_id"
              ]
            }
          }
        }
      ]
    },
    "vendor_id": {
      "type": "string",
      "pattern": "^org:[a-z0-9][a-z0-9.+-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^sys:[a-z0-9][a-z0-9./+-]*$"
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor_id",
        "name"
      ],
      "properties": {
        "vendor_id": {
          "$ref": "#/$defs/vendor_id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "model_prefixes": {
          "description": "Leading words removed from system names before keying, e.g. 'hpe', 'proliant' is not one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "system_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "name"
      ],
      "properties": {
        "system_id": {
          "$ref": "#/$defs/system_id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "vendor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vendor_id"
          },
          "uniqueItems": true
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        }
      }
    }
  }
}
