{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeoChen1024/CPUShowSpeed/data/curated/schema.json",
  "title": "CPUShowSpeed curated tables",
  "description": "Row schemas and table contracts for data/curated. Semantics are owned by docs/data-schema.md.",
  "x-schema-version": "1.6.0",
  "x-tables": {
    "source": {
      "file": "source.jsonl",
      "row": "#/$defs/source",
      "primary_key": "source_id",
      "description": "One identified document, page revision or dataset snapshot."
    },
    "processor_family": {
      "file": "processor_family.jsonl",
      "row": "#/$defs/processor_family",
      "primary_key": "family_id",
      "foreign_keys": {
        "source_ids": "source"
      },
      "description": "Most specific processor line a source text can identify (e.g. Intel Xeon, IBM POWER7)."
    },
    "processor_sku": {
      "file": "processor_sku.jsonl",
      "row": "#/$defs/processor_sku",
      "primary_key": "sku_id",
      "foreign_keys": {
        "family_id": "processor_family",
        "source_ids": "source"
      },
      "description": "One sold processor model; generation labels stay verbatim from sources."
    },
    "alias": {
      "file": "alias.jsonl",
      "row": "#/$defs/alias",
      "primary_key": "alias_id",
      "foreign_keys": {
        "entity_id": "@entity_kind",
        "source_id": "source"
      },
      "description": "Judgements linking source text to entities: exact text, regex pattern or a versioned rule."
    },
    "vendor": {
      "file": "vendor.jsonl",
      "row": "#/$defs/vendor",
      "primary_key": "vendor_id",
      "description": "Organisations named as hardware vendors; only spellings of one legal entity are merged."
    },
    "system_model": {
      "file": "system_model.jsonl",
      "row": "#/$defs/system_model",
      "primary_key": "system_id",
      "foreign_keys": {
        "vendor_ids": "vendor",
        "source_ids": "source"
      },
      "description": "Hand-curated system models; SPEC models are derived by rule spec-system-v1 at build time."
    },
    "date_event": {
      "file": "date_event.jsonl",
      "row": "#/$defs/date_event",
      "primary_key": "event_id",
      "foreign_keys": {
        "subject_id": "@subject_kind",
        "source_id": "source"
      },
      "description": "Something that happened to a processor or system model on a date, according to one source."
    },
    "review": {
      "file": "review.jsonl",
      "row": "#/$defs/review_row",
      "primary_key": "review_id",
      "foreign_keys": {
        "source_id": "source"
      },
      "description": "Judgements qualifying extracted evidence: rejected result dates, accepted result pairs, identity links awaiting review."
    },
    "metric": {
      "file": "metric.jsonl",
      "row": "#/$defs/metric",
      "primary_key": "metric_id",
      "description": "Observation metric strings and the registry metric each measures."
    },
    "curated_observation": {
      "file": "observation.jsonl",
      "row": "#/$defs/curated_observation",
      "primary_key": "observation_id",
      "foreign_keys": {
        "source_id": "source",
        "metric_id": "metric"
      },
      "description": "Hand-transcribed benchmark values: the printed value and unit, conditions and whether the value enters calibration."
    }
  },
  "$defs": {
    "iso_day": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "partial_date": {
      "description": "ISO text at its stated precision; quarters are YYYY-Qn.",
      "type": "string",
      "pattern": "^[0-9]{4}(-Q[1-4]|-(0[1-9]|1[0-2])(-(0[1-9]|[12][0-9]|3[01]))?)?$"
    },
    "date_precision": {
      "enum": [
        "year",
        "quarter",
        "month",
        "day"
      ]
    },
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^src:[a-z0-9][a-z0-9._/@+-]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "origin"
      ],
      "properties": {
        "status": {
          "enum": [
            "citation_only",
            "search_excerpt_only",
            "inventory_only",
            "index_reviewed",
            "text_reviewed",
            "method_text_checked",
            "thread_text_checked",
            "relevant_section_checked",
            "metadata_indexed_section_and_run_instructions_checked",
            "selected_table_pages_rendered_and_layout_spot_checked",
            "selected_pages_verified",
            "date_scope_review_complete",
            "machine_parsed_unreviewed"
          ]
        },
        "scope": {
          "description": "What the review covered, e.g. a page range, claim type or locator.",
          "$ref": "#/$defs/text"
        },
        "reviewed_on": {
          "$ref": "#/$defs/iso_day"
        },
        "origin": {
          "description": "Legacy registry the review was migrated from.",
          "$ref": "#/$defs/text"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "kind",
        "provenance_class",
        "acquisition_status",
        "reviews"
      ],
      "properties": {
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "kind": {
          "enum": [
            "pdf",
            "postscript",
            "web_page",
            "wiki_revision",
            "spec_result",
            "text_file",
            "program_source",
            "archive_file",
            "usenet_post",
            "book",
            "dataset"
          ]
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "url": {
          "$ref": "#/$defs/text"
        },
        "final_url": {
          "$ref": "#/$defs/text"
        },
        "alternate_urls": {
          "description": "Other spellings of the same source's address found in legacy registries.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "member_url_prefix": {
          "description": "Dataset of individually retrieved pages: a page whose URL starts with this prefix belongs to it.",
          "type": "string",
          "pattern": "^https?://"
        },
        "store": {
          "description": "Root that local_path is relative to.",
          "enum": [
            "bitsavers_mirror",
            "repo"
          ]
        },
        "local_path": {
          "$ref": "#/$defs/text"
        },
        "hash_algo": {
          "enum": [
            "blake3",
            "sha256"
          ]
        },
        "hash": {
          "$ref": "#/$defs/hex64"
        },
        "revision": {
          "$ref": "#/$defs/text"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "retrieved_on": {
          "$ref": "#/$defs/iso_day"
        },
        "date": {
          "description": "Publication date of the source itself.",
          "$ref": "#/$defs/partial_date"
        },
        "date_precision": {
          "$ref": "#/$defs/date_precision"
        },
        "provenance_class": {
          "enum": [
            "primary_original",
            "vendor",
            "contemporary_secondary",
            "modern_secondary",
            "historical_museum",
            "benchmark_org",
            "unclassified"
          ]
        },
        "provider": {
          "$ref": "#/$defs/text"
        },
        "work_id": {
          "description": "Groups sources from one work or compilation so they are not counted as independent.",
          "$ref": "#/$defs/text"
        },
        "families": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "role": {
          "$ref": "#/$defs/text"
        },
        "acquisition_status": {
          "enum": [
            "not_acquired",
            "acquired",
            "failed"
          ]
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          }
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "legacy_ids": {
          "description": "Identities this row was migrated from, as <registry>:<key>; absent for sources added directly to the table.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "dependentRequired": {
        "date": [
          "date_precision"
        ],
        "date_precision": [
          "date"
        ],
        "hash": [
          "hash_algo"
        ],
        "hash_algo": [
          "hash"
        ],
        "local_path": [
          "store"
        ],
        "store": [
          "local_path"
        ]
      }
    },
    "family_id": {
      "type": "string",
      "pattern": "^fam:[a-z0-9][a-z0-9.+-]*$"
    },
    "sku_id": {
      "type": "string",
      "pattern": "^sku:[a-z0-9][a-z0-9.+-]*$"
    },
    "alias_id": {
      "type": "string",
      "pattern": "^alias:[a-z0-9][a-z0-9./+-]*$"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_id"
      },
      "uniqueItems": true
    },
    "processor_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "vendor",
        "name"
      ],
      "properties": {
        "family_id": {
          "$ref": "#/$defs/family_id"
        },
        "vendor": {
          "$ref": "#/$defs/text"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "clock_variants_only": {
          "description": "Every member is one processor design differing only in clock frequency or enabled cores, which disclosures report separately; a family-level match may then pair hardware. Absent means not established.",
          "type": "boolean"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        }
      }
    },
    "processor_sku": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sku_id",
        "family_id",
        "vendor",
        "model",
        "keys",
        "source_ids"
      ],
      "properties": {
        "sku_id": {
          "$ref": "#/$defs/sku_id"
        },
        "family_id": {
          "$ref": "#/$defs/family_id"
        },
        "vendor": {
          "$ref": "#/$defs/text"
        },
        "model": {
          "description": "Model name as printed in the source table.",
          "$ref": "#/$defs/text"
        },
        "keys": {
          "description": "Match keys produced by versioned rules, as <rule>:<key>.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "base_clocks_mhz": {
          "description": "Every base frequency listed for this model; several when revisions differ.",
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "uniqueItems": true
        },
        "sections": {
          "description": "Verbatim source heading paths (generation, codename).",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids",
          "minItems": 1
        }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias_id",
        "entity_kind",
        "match_kind",
        "scope",
        "status"
      ],
      "properties": {
        "alias_id": {
          "$ref": "#/$defs/alias_id"
        },
        "entity_kind": {
          "enum": [
            "processor_sku",
            "processor_family",
            "vendor",
            "system_model"
          ]
        },
        "entity_id": {
          "description": "Target entity; omitted for rules and for rejected exact-text aliases.",
          "$ref": "#/$defs/text"
        },
        "match_kind": {
          "enum": [
            "exact_text",
            "pattern",
            "rule"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "pattern": {
          "$ref": "#/$defs/text"
        },
        "rule_id": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "description": "processor, processor-from-system (matches a system name when the processor text resolves nothing), vendor or system; optionally @<glob> over mention scopes.",
          "$ref": "#/$defs/text"
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "clock_within": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "clock_mhz": {
              "description": "Exact-text alias applies only to mentions with this nominal clock (within 1%).",
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "status": {
          "enum": [
            "accepted",
            "candidate",
            "rejected"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "reviewed_on": {
          "$ref": "#/$defs/iso_day"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "match_kind": {
                "const": "exact_text"
              }
            }
          },
          "then": {
            "required": [
              "text"
            ],
            "if": {
              "properties": {
                "status": {
                  "const": "rejected"
                }
              }
            },
            "else": {
              "required": [
                "entity_id"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "match_kind": {
                "const": "pattern"
              }
            }
          },
          "then": {
            "required": [
              "pattern",
              "entity_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "match_kind": {
                "const": "rule"
              }
            }
          },
          "then": {
            "required": [
              "rule_id"
            ],
            "not": {
              "required": [
                "entity_id"
              ]
            }
          }
        }
      ]
    },
    "vendor_id": {
      "type": "string",
      "pattern": "^org:[a-z0-9][a-z0-9.+-]*$"
    },
    "system_id": {
      "type": "string",
      "pattern": "^sys:[a-z0-9][a-z0-9./+-]*$"
    },
    "vendor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendor_id",
        "name"
      ],
      "properties": {
        "vendor_id": {
          "$ref": "#/$defs/vendor_id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "model_prefixes": {
          "description": "Leading words removed from system names before keying, e.g. 'hpe', 'proliant' is not one.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "uniqueItems": true
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "system_model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_id",
        "name"
      ],
      "properties": {
        "system_id": {
          "$ref": "#/$defs/system_id"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "vendor_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/vendor_id"
          },
          "uniqueItems": true
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "source_ids": {
          "$ref": "#/$defs/source_ids"
        }
      }
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt:[a-z0-9][a-z0-9./+@-]*$"
    },
    "date_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "subject_kind",
        "subject_id",
        "event_type",
        "date",
        "date_precision",
        "claim_status",
        "chronology",
        "source_id",
        "verification",
        "legacy_ids"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/event_id"
        },
        "subject_kind": {
          "enum": [
            "processor_sku",
            "processor_family",
            "system_model"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/text"
        },
        "event_type": {
          "enum": [
            "announcement",
            "introduction",
            "release",
            "first_delivery",
            "first_installation",
            "availability",
            "configuration_availability",
            "market_release",
            "reannouncement",
            "option_announcement",
            "family_introduction",
            "architecture_introduction",
            "operation",
            "demonstration_installation",
            "public_demonstration",
            "model_year",
            "general_availability",
            "listed_in_timeline",
            "contemporary_new_product_listing",
            "contemporary_advertisement",
            "processor_introduction",
            "processor_family_introduction"
          ]
        },
        "date": {
          "$ref": "#/$defs/partial_date"
        },
        "date_precision": {
          "$ref": "#/$defs/date_precision"
        },
        "date_raw": {
          "$ref": "#/$defs/text"
        },
        "claim_status": {
          "description": "What the source asserts: a reported event, a plan, a future announcement, or a proxy chosen by review.",
          "enum": [
            "reported",
            "planned",
            "announced_future",
            "prospective_or_not_confirmed_as_delivered",
            "internally_inconsistent",
            "inferred_proxy"
          ]
        },
        "chronology": {
          "description": "Use in chronology selection: primary evidence, fallback only when nothing better exists, or excluded.",
          "enum": [
            "primary",
            "fallback",
            "excluded"
          ]
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "verification": {
          "enum": [
            "original_page_visual_check",
            "web_text_checked",
            "web_page_checked_secondary_source",
            "parsed_unreviewed",
            "reviewed_proxy"
          ]
        },
        "reviewed_on": {
          "$ref": "#/$defs/iso_day"
        },
        "note": {
          "$ref": "#/$defs/text"
        },
        "legacy_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "review_id": {
      "type": "string",
      "pattern": "^rev:[a-z0-9][a-z0-9./+@-]*$"
    },
    "result_selector": {
      "description": "One extracted result by ID, or every result whose exact system text appears in one scope.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "result_id"
          ],
          "properties": {
            "result_id": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scope",
            "system"
          ],
          "properties": {
            "scope": {
              "$ref": "#/$defs/text"
            },
            "system": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "system_selector": {
      "description": "Hardware records with this exact system text in one scope.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "system"
      ],
      "properties": {
        "scope": {
          "$ref": "#/$defs/text"
        },
        "system": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "review_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_id",
        "target_kind",
        "target",
        "decision",
        "reason",
        "reviewed_on"
      ],
      "properties": {
        "review_id": {
          "$ref": "#/$defs/review_id"
        },
        "target_kind": {
          "description": "result_date: one date a result reports; result_pair: two results treated as one configuration; system_link: two source system texts that may denote one machine.",
          "enum": [
            "result_date",
            "result_pair",
            "system_link"
          ]
        },
        "target": {
          "type": "object"
        },
        "field": {
          "description": "result_date only: which reported date.",
          "enum": [
            "hardware_availability",
            "table_year",
            "publication",
            "test"
          ]
        },
        "decision": {
          "enum": [
            "accept",
            "reject",
            "needs_review"
          ]
        },
        "reason": {
          "$ref": "#/$defs/text"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "locator": {
          "$ref": "#/$defs/text"
        },
        "reviewed_on": {
          "$ref": "#/$defs/iso_day"
        },
        "legacy_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "minItems": 1,
          "uniqueItems": true,
          "description": "Legacy registry keys a migrated review came from; absent for reviews made in this table."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "result_date"
              }
            }
          },
          "then": {
            "required": [
              "field"
            ],
            "properties": {
              "target": {
                "$ref": "#/$defs/result_selector"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "field"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "result_pair"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "left",
                  "right"
                ],
                "properties": {
                  "left": {
                    "$ref": "#/$defs/result_selector"
                  },
                  "right": {
                    "$ref": "#/$defs/result_selector"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "target_kind": {
                "const": "system_link"
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "left",
                  "right"
                ],
                "properties": {
                  "left": {
                    "$ref": "#/$defs/system_selector"
                  },
                  "right": {
                    "$ref": "#/$defs/system_selector"
                  }
                }
              }
            }
          }
        }
      ]
    },
    "metric_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:]+$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "registry_metric",
        "mode",
        "unit",
        "track"
      ],
      "properties": {
        "metric_id": {
          "$ref": "#/$defs/metric_id",
          "description": "The metric string observations carry."
        },
        "registry_metric": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$",
          "description": "Metric id in research/model-registry.json; adapters of one suite share it."
        },
        "mode": {
          "enum": [
            "base",
            "peak",
            "reported"
          ]
        },
        "unit": {
          "$ref": "#/$defs/text"
        },
        "track": {
          "enum": [
            "rate",
            "speed",
            "classical",
            "instruction_mix"
          ]
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "curated_observation_id": {
      "type": "string",
      "pattern": "^cobs:[a-z0-9][a-z0-9._:/+-]*$"
    },
    "curated_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_id",
        "result_id",
        "source_id",
        "locator",
        "system",
        "metric_id",
        "value_printed",
        "value",
        "unit_printed",
        "conditions",
        "measured_by",
        "use",
        "verification",
        "reviewed_on"
      ],
      "properties": {
        "observation_id": {
          "$ref": "#/$defs/curated_observation_id"
        },
        "result_id": {
          "description": "Values reported together for one system, configuration and run; one source column or row.",
          "$ref": "#/$defs/text"
        },
        "source_id": {
          "$ref": "#/$defs/source_id"
        },
        "locator": {
          "description": "Page or section and the table or figure, as printed.",
          "$ref": "#/$defs/text"
        },
        "system": {
          "description": "System name exactly as printed.",
          "$ref": "#/$defs/text"
        },
        "metric_id": {
          "$ref": "#/$defs/metric_id"
        },
        "value_printed": {
          "description": "The cell exactly as printed.",
          "$ref": "#/$defs/text"
        },
        "value": {
          "description": "The printed number in the printed unit; never rescaled here.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit_printed": {
          "description": "Unit as printed; extraction converts it to the metric unit by a named rule.",
          "enum": [
            "DMIPS",
            "Dhrystones/s",
            "MWIPS",
            "KWIPS",
            "MFLOPS",
            "KFLOPS",
            "native_suite_points"
          ]
        },
        "reviewed_reading": {
          "description": "The reviewed reading of a cell whose printed unit label or magnitude is wrong or incomplete; extraction converts this instead of the printed value.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "unit",
            "basis"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "enum": [
                "DMIPS",
                "Dhrystones/s",
                "MWIPS",
                "KWIPS",
                "MFLOPS",
                "KFLOPS",
                "native_suite_points"
              ]
            },
            "basis": {
              "$ref": "#/$defs/text"
            }
          }
        },
        "conditions": {
          "description": "Source-stated configuration and run conditions (clock_mhz, memory_mb, os, compiler, optimization, precision, blas, fpu). Absent keys are unknown, not equal.",
          "type": "object"
        },
        "measured_by": {
          "description": "Who ran it, per the source: its author, a third party it cites, or not stated.",
          "enum": [
            "source_author",
            "cited_third_party",
            "unattributed"
          ]
        },
        "cited_reference": {
          "$ref": "#/$defs/text"
        },
        "use": {
          "description": "calibration_input rows are extracted as observations; context rows stay in this table only.",
          "enum": [
            "calibration_input",
            "context"
          ]
        },
        "use_note": {
          "$ref": "#/$defs/text"
        },
        "duplicates": {
          "description": "Other sources printing the same value for the same system, likely one measurement.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_id"
          },
          "uniqueItems": true
        },
        "verification": {
          "enum": [
            "original_page_visual_check",
            "pdf_text_layer_checked",
            "usenet_text_checked"
          ]
        },
        "reviewed_on": {
          "$ref": "#/$defs/iso_day"
        },
        "note": {
          "$ref": "#/$defs/text"
        }
      }
    }
  }
}
